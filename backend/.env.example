# =============================================================================
# Prism Pro — backend environment variables
# Copy to backend/.env and fill in real values. Never commit backend/.env.
# =============================================================================

# --- LLM (REQUIRED) ----------------------------------------------------------
# OpenAI API key. Used by: evaluator, rewriter, JD extractor, JD tailor.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Database (REQUIRED) -----------------------------------------------------
# Single URI string. Local dev: Supabase direct connection works.
# Production (Railway): use Supabase SESSION POOLER URI (IPv4-only routing):
#   postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres
# URL-encode special chars in <pwd> (@ → %40, # → %23, etc.) or use a password
# without special chars.
SQLALCHEMY_DATABASE_URI=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- Supabase (REQUIRED) -----------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Service role key — required for Storage uploads + admin operations.
# Get from Supabase Dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Storage bucket name (private, RLS-policy-gated). Create in Supabase Storage.
SUPABASE_STORAGE_BUCKET=resume

# --- Freemium launch ---------------------------------------------------------
FREEMIUM_MONTHLY_CREDITS=90
ENABLE_BILLING=false

# --- Public preview ----------------------------------------------------------
# Fail-closed when omitted. Keep true on the public promotional deployment.
# Use a separate internal deployment with an explicit false value for testers.
PRISM_PRO_PUBLIC_PREVIEW_ONLY=true
# Entries become eligible for deletion after this many days. A deletion/export
# request can be sent to support@prismpro.live.
WAITLIST_RETENTION_DAYS=180
# Bump this value whenever the waitlist consent language materially changes.
WAITLIST_CONSENT_VERSION=2026-09-06

# --- Admin (OPTIONAL) --------------------------------------------------------
# Comma-separated Supabase auth user IDs allowed to call admin endpoints.
ADMIN_USER_IDS=

# --- Server (OPTIONAL — defaults usually fine) -------------------------------
# Comma-separated origins. "*" allowed locally; lock down in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Resume parser resource budgets. Defaults shown; tune only after measured load tests.
MAX_UPLOAD_SIZE=10485760
MAX_PDF_PAGES=10
MAX_EXTRACTED_TEXT_CHARS=100000
MAX_DOCX_ENTRIES=2000
MAX_DOCX_UNCOMPRESSED_SIZE=26214400
MAX_DOCX_COMPRESSION_RATIO=100
RESUME_PARSE_TIMEOUT_SECONDS=15
MAX_CONCURRENT_RESUME_PARSERS=2
RESUME_PARSE_QUEUE_TIMEOUT_SECONDS=1
