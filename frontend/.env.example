# =============================================================================
# Prism Pro — frontend environment variables
# Copy to frontend/.env.local and fill in real values. Never commit .env.local.
# NEXT_PUBLIC_* values are inlined into the browser bundle — never put secrets here.
# =============================================================================

# Backend API base URL.
# Local dev: http://localhost:8000
# Production: https://api.prismpro.live
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Public launch mode ------------------------------------------------------
# Defaults to true when omitted. While true, authentication, onboarding,
# documentation, and all dashboard routes redirect to the promotional page.
# The callback/confirmation handlers also refuse to create a session.
# Keep this true on the public production deployment. Use a separate internal
# deployment with this explicitly set to false when testers need product access.
PRISM_PRO_PUBLIC_PREVIEW_ONLY=true

# --- Supabase (REQUIRED when public preview mode is disabled) ----------------
# Public values only. Service role key NEVER goes here.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google OAuth (REQUIRED when public preview mode is disabled) ------------
# OAuth 2.0 client ID from Google Cloud Console → APIs & Services → Credentials.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# --- Site URLs ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
