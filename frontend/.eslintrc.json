{
  "root": true,
  "extends": ["next/core-web-vitals", "next/typescript"],
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "globals": {
    "React": "readonly",
    "NodeJS": "readonly",
    "RequestInit": "readonly"
  },
  "rules": {
    // ERRORS - These prevent actual bugs that crash the app
    "no-unreachable": "error",
    "no-dupe-keys": "error",
    "no-constant-condition": "error",

    // WARNINGS - Good practice but not critical for functionality
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "react-hooks/exhaustive-deps": "warn",
    "no-undef": "warn",  // Changed to warn for flexibility

    // OFF - Too strict and can break working functionality
    "react/no-unescaped-entities": "off"
  }
}

